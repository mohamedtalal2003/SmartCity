{
  "Ports": { "Http": 5210 },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=vehiclecomm_db;Username=vehiclecomm_svc;Password=vehiclecomm_svc"
  },
  "RabbitMQ": { "Host": "localhost", "VirtualHost": "/" },
  "S3": { "ServiceUrl": "http://localhost:9000", "ForcePathStyle": true, "Region": "us-east-1", "PublicBaseUrl": "http://localhost:9000" },
  "Seq": { "ServerUrl": "http://localhost:5341" },
  "FrameCheck": {
    "MaxGpsAccuracyMeters": 25,
    "MaxImageBytes": 4194304,
    "MaxFutureMinutes": 5,
    "FrameTtlHours": 24,
    "MinLatitude": 40.80,
    "MaxLatitude": 41.60,
    "MinLongitude": 27.95,
    "MaxLongitude": 29.98
  },
  "Ingest": { "MaxFramesPerSecondPerVehicle": 5 },
  "FrameStorage": {
    "Bucket": "frames-temp",
    "RetryCount": 3,
    "RetryFirstDelayMs": 200,
    "AttemptTimeoutSeconds": 5,
    "BreakerFailureRatio": 0.5,
    "BreakerMinimumThroughput": 3,
    "BreakerSamplingSeconds": 30,
    "BreakerBreakSeconds": 30
  },
  "Seed": { "DevVehicles": false },
  "AllowedHosts": "*"
}
