  <ItemGroup>
    <ProjectReference Include="../SmartCity.VehicleCommunication.Application/SmartCity.VehicleCommunication.Application.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/SmartCity.BuildingBlocks/SmartCity.BuildingBlocks.csproj" />
  </ItemGroup>
</Project>
